<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Smart AI Signal Bot</title>
  <style>
    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #0b0f19;
      color: #e5e5e5;
    }
    .app {
      display: flex;
      flex-direction: column;
      height: 100vh;
    }
    .top-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 10px 20px;
      background: #111827;
      border-bottom: 1px solid #1f2937;
    }
    .title {
      font-size: 18px;
      font-weight: bold;
      color: #22c55e;
    }
    .clock {
      font-size: 14px;
      color: #9ca3af;
    }
    .main {
      flex: 1;
      display: grid;
      grid-template-columns: 260px 1fr 320px;
      gap: 10px;
      padding: 10px 20px;
    }
    .panel {
      background: #111827;
      border: 1px solid #1f2937;
      border-radius: 8px;
      padding: 10px;
      box-sizing: border-box;
    }
    .panel h3 {
      margin: 0 0 8px;
      font-size: 14px;
      color: #e5e5e5;
      border-bottom: 1px solid #1f2937;
      padding-bottom: 4px;
    }
    select, button {
      width: 100%;
      margin-bottom: 8px;
      padding: 6px 8px;
      border-radius: 4px;
      border: 1px solid #374151;
      background: #020617;
      color: #e5e5e5;
      font-size: 13px;
    }
    button {
      cursor: pointer;
      background: #16a34a;
      border-color: #16a34a;
      font-weight: bold;
    }
    button:hover {
      background: #22c55e;
    }
    .timing-buttons {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 6px;
      margin-bottom: 8px;
    }
    .timing-buttons button {
      background: #1f2937;
      border-color: #374151;
      font-weight: normal;
    }
    .timing-buttons button.active {
      background: #22c55e;
      border-color: #22c55e;
      color: #020617;
      font-weight: bold;
    }
    .chart-area {
      height: 100%;
      border-radius: 8px;
      overflow: hidden;
      background: #020617;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #6b7280;
      font-size: 14px;
    }
    .signal-panel {
      margin-bottom: 10px;
      padding: 8px;
      border-radius: 8px;
      background: #020617;
      border: 1px solid #374151;
      transition: box-shadow 0.3s, border-color 0.3s;
    }
    .signal-panel.glow-buy {
      box-shadow: 0 0 12px #22c55e;
      border-color: #22c55e;
    }
    .signal-panel.glow-sell {
      box-shadow: 0 0 12px #ef4444;
      border-color: #ef4444;
    }
    .signal-panel.glow-neutral {
      box-shadow: 0 0 12px #6b7280;
      border-color: #6b7280;
    }
    .signal-main {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 6px;
    }
    .signal-direction {
      font-size: 18px;
      font-weight: bold;
    }
    .signal-direction.buy {
      color: #22c55e;
    }
    .signal-direction.sell {
      color: #ef4444;
    }
    .signal-direction.neutral {
      color: #9ca3af;
    }
    .signal-score {
      font-size: 14px;
      color: #e5e5e5;
    }
    .signal-meta {
      font-size: 12px;
      color: #9ca3af;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 2px 8px;
    }
    .history-list {
      list-style: none;
      padding: 0;
      margin: 0;
      font-size: 12px;
      max-height: 180px;
      overflow-y: auto;
    }
    .history-list li {
      padding: 4px 0;
      border-bottom: 1px solid #1f2937;
    }
    .badge {
      display: inline-block;
      padding: 2px 6px;
      border-radius: 999px;
      font-size: 11px;
      margin-left: 4px;
    }
    .badge-live {
      background: #22c55e;
      color: #020617;
    }
    .badge-otc {
      background: #f97316;
      color: #020617;
    }
    .badge-custom {
      background: #3b82f6;
      color: #020617;
    }
    .popup-alert {
      position: fixed;
      right: 20px;
      bottom: 20px;
      background: #111827;
      border: 1px solid #22c55e;
      color: #e5e5e5;
      padding: 8px 12px;
      border-radius: 6px;
      font-size: 12px;
      box-shadow: 0 0 10px #22c55e;
      display: none;
      z-index: 9999;
    }
  </style>
</head>

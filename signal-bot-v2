<script>
  const FINNHUB_API_KEY = "db9n5p9r01qkqqs3cflgdb9n5p9r01qkqqs3cfm0";

  const clockEl = document.getElementById("clock");
  const modeSelect = document.getElementById("modeSelect");
  const brokerSelect = document.getElementById("brokerSelect");
  const pairSelect = document.getElementById("pairSelect");
  const marketStatusEl = document.getElementById("marketStatus");
  const timingButtonsEl = document.getElementById("timingButtons");
  const createSignalBtn = document.getElementById("createSignalBtn");
  const autoToggleBtn = document.getElementById("autoToggleBtn");
  const signalPanel = document.getElementById("signalPanel");
  const signalDirectionEl = document.getElementById("signalDirection");
  const signalScoreEl = document.getElementById("signalScore");
  const riskLevelEl = document.getElementById("riskLevel");
  const trendArrowEl = document.getElementById("trendArrow");
  const sessionInfoEl = document.getElementById("sessionInfo");
  const modeInfoEl = document.getElementById("modeInfo");
  const timingInfoEl = document.getElementById("timingInfo");
  const sourceInfoEl = document.getElementById("sourceInfo");
  const historyListEl = document.getElementById("historyList");
  const popupAlertEl = document.getElementById("popupAlert");

  let selectedTimingSeconds = null;
  let autoIntervalId = null;
  let prevPrice = null;
  let priceWindow = [];

  function updateClock() {
    const now = new Date();
    clockEl.textContent = now.toLocaleString();
  }
  setInterval(updateClock, 1000);
  updateClock();

  function setTiming(seconds) {
    selectedTimingSeconds = seconds;
    Array.from(timingButtonsEl.querySelectorAll("button")).forEach(btn => {
      const s = parseInt(btn.getAttribute("data-seconds"), 10);
      btn.classList.toggle("active", s === seconds);
    });
    timingInfoEl.textContent = seconds ? seconds + "s" : "N/A";
  }

  timingButtonsEl.addEventListener("click", (e) => {
    if (e.target.tagName === "BUTTON") {
      const seconds = parseInt(e.target.getAttribute("data-seconds"), 10);
      setTiming(seconds);
    }
  });

  function getSessionInfo() {
    const now = new Date();
    const utcHour = now.getUTCHours();
    let session = "Off Session";
    let booster = 0;

    if (utcHour >= 7 && utcHour < 13) {
      session = "London Session";
      booster = 3;
    }
    if (utcHour >= 13 && utcHour < 16) {
      session = "Overlap Session";
      booster = 5;
    }
    if (utcHour >= 16 && utcHour < 22) {
      session = "New York Session";
      booster = 4;
    }

    return { session, booster };
  }

  // ===== BASIC INDICATOR PLACEHOLDERS =====
  function EMA(candles, period) {
    if (!candles || candles.length < period) return { direction: "flat" };
    const last = candles[candles.length - 1];
    const first = candles[candles.length - period];
    const slope = last.close - first.close;
    if (slope > 0) return { direction: "up" };
    if (slope < 0) return { direction: "down" };
    return { direction: "flat" };
  }
  function Keltner(candles) {
    if (!candles || candles.length < 10) return { direction: "flat", middleSlope: "flat" };
    const last = candles[candles.length - 1];
    const first = candles[candles.length - 10];
    const slope = last.close - first.close;
    const dir = slope > 0 ? "up" : slope < 0 ? "down" : "flat";
    return { direction: dir, middleSlope: dir };
  }
  function FRAMA(candles) {
    return EMA(candles, 14);
  }
  function Fractal(candles) {
    if (!candles || candles.length < 5) return { structure: "NONE" };
    const last = candles[candles.length - 1];
    const prev = candles[candles.length - 5];
    if (last.close > prev.close) return { structure: "HH-HL" };
    if (last.close < prev.close) return { structure: "LH-LL" };
    return { structure: "SIDEWAYS" };
  }

  // ===== CANDLE TYPE HELPERS =====
  function isBullish(c) { return c.close > c.open; }
  function isBearish(c) { return c.close < c.open; }

  // ===== CANDLE PATTERN LOGIC =====
  function isBullishEngulfing(last, prev) {
    if (!last || !prev) return false;
    return (
      isBearish(prev) &&
      isBullish(last) &&
      last.open <= prev.close &&
      last.close >= prev.open
    );
  }

  function isBearishEngulfing(last, prev) {
    if (!last || !prev) return false;
    return (
      isBullish(prev) &&
      isBearish(last) &&
      last.open >= prev.close &&
      last.close <= prev.open
    );
  }

  function isBullishHarami(prev, last) {
    if (!last || !prev) return false;
    return (
      isBearish(prev) &&
      isBullish(last) &&
      last.open > prev.close &&
      last.close < prev.open
    );
  }

  function isBearishHarami(prev, last) {
    if (!last || !prev) return false;
    return (
      isBullish(prev) &&
      isBearish(last) &&
      last.open < prev.close &&
      last.close > prev.open
    );
  }

  function isPiercingLine(prev, last) {
    if (!last || !prev) return false;
    const midPrev = (prev.open + prev.close) / 2;
    return (
      isBearish(prev) &&
      isBullish(last) &&
      last.open < prev.low &&
      last.close > midPrev
    );
  }

  function isMorningStar(candles) {
    if (!candles || candles.length < 3) return false;
    const a = candles[candles.length - 3];
    const b = candles[candles.length - 2];
    const c = candles[candles.length - 1];
    return (
      isBearish(a) &&
      Math.abs(b.close - b.open) < Math.abs(a.open - a.close) * 0.3 &&
      isBullish(c) &&
      c.close > ((a.open + a.close) / 2)
    );
  }

  function isEveningStar(candles) {
    if (!candles || candles.length < 3) return false;
    const a = candles[candles.length - 3];
    const b = candles[candles.length - 2];
    const c = candles[candles.length - 1];
    return (
      isBullish(a) &&
      Math.abs(b.close - b.open) < Math.abs(c.open - c.close) * 0.3 &&
      isBearish(c) &&
      c.close < ((a.open + a.close) / 2)
    );
  }

  function isTweezerBottom(candles) {
    if (!candles || candles.length < 2) return false;
    const a = candles[candles.length - 2];
    const b = candles[candles.length - 1];
    return (
      isBearish(a) &&
      isBullish(b) &&
      Math.abs(a.low - b.low) <= (a.high - a.low) * 0.1
    );
  }

  function isTweezerTop(candles) {
    if (!candles || candles.length < 2) return false;
    const a = candles[candles.length - 2];
    const b = candles[candles.length - 1];
    return (
      isBullish(a) &&
      isBearish(b) &&
      Math.abs(a.high - b.high) <= (a.high - a.low) * 0.1
    );
  }

  function hasStrongWickDown(c) {
    if (!c) return false;
    const body = Math.abs(c.close - c.open);
    const lowerWick = c.open < c.close ? c.open - c.low : c.close - c.low;
    return lowerWick > body * 1.5;
  }

  function hasStrongWickUp(c) {
    if (!c) return false;
    const body = Math.abs(c.close - c.open);
    const upperWick = c.high - (c.open < c.close ? c.close : c.open);
    return upperWick > body * 1.5;
  }

  // ===== LIQUIDITY LOGIC =====
  function getRecentHigh(candles, lookback = 10) {
    const slice = candles.slice(-lookback);
    return Math.max(...slice.map(c => c.high));
  }
  function getRecentLow(candles, lookback = 10) {
    const slice = candles.slice(-lookback);
    return Math.min(...slice.map(c => c.low));
  }

  function isLiquiditySweepDown(candles) {
    if (!candles || candles.length < 3) return false;
    const last = candles[candles.length - 1];
    const prevLow = getRecentLow(candles.slice(0, -1), 10);
    return last.low < prevLow && last.close > prevLow;
  }

  function isLiquiditySweepUp(candles) {
    if (!candles || candles.length < 3) return false;
    const last = candles[cand
